; Engine configuration file.
; Godot 4.7 - Mera: The Baby Giant

config_version=5

[application]

config/name="Mera: The Baby Giant"
config/version="0.11.7"
config/icon="res://assets/_project/icon.png"
config/description="2D sword-and-sorcery action game starring Mera, with fighting-game combos, meter, supers and size-shifting."
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

AnimLib="*res://scripts/game/anim_lib.gd"
Sfx="*res://scripts/game/sfx.gd"
Controls="*res://scripts/game/controls.gd"
HitStop="*res://scripts/game/hit_stop.gd"
Updater="*res://scripts/app/updater.gd"
TouchPad="*res://scripts/game/touch_pad.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"
window/handheld/orientation=4

[physics]

common/physics_ticks_per_second=60

[input_devices]

pointing/android/override_volume_buttons=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.06, 0.05, 0.09, 1)
